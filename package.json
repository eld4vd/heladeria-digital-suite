{
  "name": "heladeria-digital-suite",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --dir web dev",
    "dev:admin": "pnpm --dir admin dev",
    "dev:api": "pnpm --dir api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --dir api db:generate",
    "db:migrate": "pnpm --dir api db:migrate",
    "db:seed": "pnpm --dir api db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4"
  }
}
