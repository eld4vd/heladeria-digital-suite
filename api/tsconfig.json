{
  "compilerOptions": {
    "module": "NodeNext", "moduleResolution": "NodeNext", "target": "ES2023",
    "esModuleInterop": true, "declaration": true, "emitDecoratorMetadata": true,
    "experimentalDecorators": true, "sourceMap": true, "rootDir": "./src", "outDir": "./dist",
    "strict": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"], "exclude": ["node_modules", "dist"]
}
